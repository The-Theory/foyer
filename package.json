{
  "name": "foyer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "firefox": "vite build && web-ext run -s dist",
    "chrome": "vite build && node scripts/chrome.js",
    "package": "npm run chrome && web-ext build -s dist -a release --overwrite-dest && web-ext build -s dist-chrome -a release -n foyer-chrome-{version}.zip --overwrite-dest",
    "lint:ext": "vite build && web-ext lint -s dist",
    "sign": "vite build && web-ext sign -s dist --channel unlisted -a release"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0"
  }
}
